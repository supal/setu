# Postgres connection string.
# Local (docker-compose default — host port 5433 to avoid clashing with a system Postgres on 5432):
DATABASE_URL="postgresql://sitetracker:sitetracker@localhost:5433/sitetracker?schema=public"
# Supabase (production) example — get from Supabase Project Settings > Database > Connection string (URI, "Transaction" pooler recommended):
# DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# How long the login session cookie stays valid before requiring login again.
COOKIE_MAX_AGE_DAYS=7

# Resend (https://resend.com) API key for transactional email.
# Leave unset in local dev to fall back to console-logging emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="SiteTracker <onboarding@resend.dev>"

# Public URL of the frontend (used for CORS and for building email links).
FRONTEND_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Shared secret an external scheduler (cron-job.org, GitHub Actions, etc.) presents via the
# X-Cron-Secret header (or ?secret= query param) to call POST /api/cron/cleanup-orphans
# without a logged-in session. Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-secret"

# Site photo storage: "local" writes to backend/uploads and serves them at /uploads,
# and the frontend uploads photos as a single request (pair with VITE_UPLOAD_MODE=local).
# Fine for local dev. Render's free-tier disks are ephemeral and wiped on every deploy,
# so production should use "supabase" — photos then upload directly from the browser to
# a Supabase Storage bucket (via its S3-compatible API) via a resumable (tus) endpoint at
# /api/uploads (pair with VITE_UPLOAD_MODE=tus).
STORAGE_DRIVER=local

# Only required when STORAGE_DRIVER=supabase. Supabase dashboard > Project Settings >
# Storage > S3 Connection.
# Just the bare project ref (e.g. "mzqwmljlhrmfvnctltyl") — NOT the full endpoint URL.
# The app builds the endpoint itself as https://<ref>.supabase.co/storage/v1/s3.
SUPABASE_PROJECT_REF=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# The region shown alongside the S3 connection details in the Supabase dashboard (e.g. "us-east-1").
SUPABASE_S3_REGION=
SUPABASE_BUCKET=site-photos
# The bucket's public base URL, i.e. https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# (bucket must have public read enabled). Uploaded image URLs are `${SUPABASE_PUBLIC_URL}/<key>`.
SUPABASE_PUBLIC_URL=
