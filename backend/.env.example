# Postgres connection string.
# Local (docker-compose default — host port 5433 to avoid clashing with a system Postgres on 5432):
DATABASE_URL="postgresql://sitetracker:sitetracker@localhost:5433/sitetracker?schema=public"
# Supabase (production) example — get from Supabase Project Settings > Database > Connection string (URI, "Transaction" pooler recommended):
# DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# How long the login session cookie stays valid before requiring login again.
COOKIE_MAX_AGE_DAYS=7

# Resend (https://resend.com) API key for transactional email.
# Leave unset in local dev to fall back to console-logging emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="SiteTracker <onboarding@resend.dev>"

# Public URL of the frontend (used for CORS and for building email links).
FRONTEND_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Site photo storage: "local" writes to backend/uploads and serves them at /uploads,
# and the frontend uploads photos as a single request (pair with VITE_UPLOAD_MODE=local).
# Fine for local dev. Render's free-tier disks are ephemeral and wiped on every deploy,
# so production should use "r2" — photos then upload directly from the browser to
# Cloudflare R2 via a resumable (tus) endpoint at /api/uploads (pair with VITE_UPLOAD_MODE=tus).
STORAGE_DRIVER=local

# Only required when STORAGE_DRIVER=r2. Cloudflare dashboard > R2 > Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=site-photos
# The bucket's public base URL — an R2.dev subdomain (bucket Settings > Public Access)
# or a custom domain attached to the bucket. Uploaded image URLs are `${R2_PUBLIC_URL}/<key>`.
R2_PUBLIC_URL=
