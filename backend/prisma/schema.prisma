generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String?
  role                Role      @default(USER)
  isActive            Boolean   @default(true)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sites     Site[]
  auditLogs AuditLog[]

  @@map("users")
}

model Site {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  address            String?
  constructionStatus String   @default("planned") @map("construction_status")
  latitude           Float?
  longitude          Float?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  files File[]

  @@map("sites")
}

model File {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String   @map("mime_type")
  // The one image representing this site in the list/map. At most one File per site should
  // have this set — enforced in files.controller.ts (auto-assigned to the first image
  // uploaded, auto-transferred to the next remaining image if the cover is deleted), not at
  // the DB level. Never true for non-image files.
  isCover   Boolean  @default(false) @map("is_cover")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("files")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_user_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
