# URL of the backend API.
# Local: the backend dev server.
VITE_API_URL="http://localhost:4000"
# Production: your deployed Render backend URL, e.g. https://sitetracker-backend.onrender.com

# How site photos get uploaded. "local" (default) sends the file straight to the backend
# in one request, which is all that's needed for local dev. "tus" chunks the upload directly
# to Cloudflare R2 via the backend's tus endpoint — set this in production, paired with the
# backend's STORAGE_DRIVER=r2.
VITE_UPLOAD_MODE=local
